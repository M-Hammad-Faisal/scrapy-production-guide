# Copy to .env (never commit .env). Everything here is optional.

# Storage: SQLite by default; use PostgreSQL in production (see docker-compose.yml)
# DATABASE_URL=postgresql+psycopg://crawler:crawler@localhost:5432/crawl

# Identify yourself to the sites you crawl
# USER_AGENT=my-crawler/1.0 (+https://example.com/contact)

# Comma-separated lists; the middlewares disable themselves when these are empty
# USER_AGENT_POOL=Mozilla/5.0 (...),Mozilla/5.0 (...)
# PROXY_URLS=http://user:pass@proxy1:8080,http://user:pass@proxy2:8080

# LOG_LEVEL=INFO
# HTTPCACHE_ENABLED=true     # development only: replays saved responses
# JOBDIR=jobs/books-2026-03  # pause/resume a crawl; one folder per run
# ISO_BASE_URL=http://127.0.0.1:8765
